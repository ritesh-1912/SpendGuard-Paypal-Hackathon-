# Application Base URL (Used for PayPal return_url and webhook registration)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PayPal REST API (Sandbox)
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Channel3 Product Search API
# Obtain from https://trychannel3.com
CHANNEL3_API_KEY=""
CHANNEL3_BASE_URL="https://api.trychannel3.com/v1"

# Database Configuration (Local SQLite database file path)
DATABASE_PATH="./data/spendguard.db"

# Offline Demo Mode
# Set to "true" to use offline sample catalog without Channel3 and Gemini API keys
DEMO_OFFLINE="false"

# Sandbox Testing Flag
# Set to "true" only if you want to bypass live PayPal sandbox calls
MOCK_PAYPAL_CAPTURE="false"
