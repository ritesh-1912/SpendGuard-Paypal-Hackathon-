# Application Base URL
# APP_URL is the primary server-side runtime URL (recommended for Render and deployed hosts).
# NEXT_PUBLIC_APP_URL is fallback for client-side evaluation.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# PayPal REST API (Sandbox)
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Channel3 Product Search API
# Obtain from https://trychannel3.com
CHANNEL3_API_KEY=""
CHANNEL3_BASE_URL="https://api.trychannel3.com/v1"

# Database Configuration (Local SQLite database file path)
DATABASE_PATH="./data/spendguard.db"

# Offline Demo Mode
# Set to "true" to use offline sample catalog during local development.
# Blocked in production unless ALLOW_OFFLINE_IN_PROD="true" is set.
DEMO_OFFLINE="false"
ALLOW_OFFLINE_IN_PROD="false"

# Sandbox Testing Flag
# Set to "true" only in test environments. Forbidden in production (NODE_ENV=production will fail at startup).
MOCK_PAYPAL_CAPTURE="false"
